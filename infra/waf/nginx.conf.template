load_module modules/ngx_http_modsecurity_module.so;
load_module modules/ngx_http_headers_more_filter_module.so;
worker_processes 1;
pid /tmp/nginx.pid;
# CRS rule diagnostics can contain matched passwords, tokens or biometric values.
# Keep only critical runtime faults; security outcomes are recorded by the JSON access log.
error_log /dev/stderr crit;
events { worker_connections 512; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    log_format rearm_waf escape=json '{"event":"waf_http","request_id":"$http_x_rearm_request_id","method":"$request_method","path":"$uri","status":$status,"upstream_status":"$upstream_status","duration":$request_time}';
    access_log /dev/stdout rearm_waf;
    client_body_timeout 15s;
    keepalive_timeout 30s;
    sendfile on;
    include /etc/nginx/conf.d/*.conf;
}
