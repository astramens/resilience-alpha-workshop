# HTTPS edge for the local workshop. CA private key is never mounted here.
limit_req_zone $binary_remote_addr zone=auth_attempts:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=application:10m rate=40r/s;
log_format rearm_edge escape=json '{"event":"edge_http","request_id":"$request_id","method":"$request_method","path":"$uri","status":$status,"duration":$request_time}';
map $host $rearm_https_host {
    default localhost;
    localhost localhost;
    127.0.0.1 127.0.0.1;
    __LAN_IP__ __LAN_IP__;
}
server {
    listen 8080;
    server_tokens off;
    access_log /dev/stdout rearm_edge;
    client_max_body_size 64k;
    location = /healthz { return 404; }
    # Transitional HTTP: native camera, ESP, Stripe CLI and existing read-only probe.
    location ^~ /api/face-agent/ {
        limit_req zone=application burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://waf:8080;
        include /etc/nginx/rearm-proxy.conf;
    }
    location = /api/device/led {
        if ($request_method != GET) { return 405; }
        limit_req zone=application burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://waf:8080;
        include /etc/nginx/rearm-proxy.conf;
    }
    location = /api/shop/payments/webhook {
        if ($request_method != POST) { return 405; }
        proxy_pass http://waf:8080;
        include /etc/nginx/rearm-proxy.conf;
    }
    location = /api/shop/products {
        if ($request_method != GET) { return 405; }
        limit_req zone=application burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://waf:8080;
        include /etc/nginx/rearm-proxy.conf;
    }
    location / { return 308 https://$rearm_https_host$request_uri; }
}
server {
    listen 8443 ssl;
    server_name localhost 127.0.0.1 __LAN_IP__;
    ssl_certificate /etc/nginx/tls/cert.pem;
    ssl_certificate_key /etc/nginx/tls/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_tickets off;
    ssl_session_cache shared:rearm_tls:5m;
    ssl_ciphers HIGH:!aNULL:!MD5:!3DES:!RC4;
    server_tokens off;
    access_log /dev/stdout rearm_edge;
    client_max_body_size 64k;
    # HSTS is deliberately absent: Grafana still uses http://localhost:3001.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy same-origin always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;
    proxy_cookie_flags ra_session secure httponly samesite=strict;
    proxy_cookie_flags rc_session secure httponly samesite=strict;
    location = /healthz { return 404; }
    location ~ ^/api/(customer/(login|register)|auth/(identify|login))$ {
        limit_req zone=auth_attempts burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://waf:8080;
        include /etc/nginx/rearm-proxy.conf;
    }
    location / {
        limit_req zone=application burst=80 nodelay;
        limit_req_status 429;
        proxy_pass http://waf:8080;
        include /etc/nginx/rearm-proxy.conf;
    }
}
