  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Ce qui est réellement mesuré",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "**Sondes HTTP internes toutes les 15 secondes.** Le catalogue est sondé via edge et le WAF ; API et authentification vérifient aussi leur accès à PostgreSQL. La sonde remédiation contrôle son endpoint de santé, pas sa capacité à réparer.\n\n**Un voyant vert ne prouve pas qu’un paiement fonctionne ni qu’une faille est corrigée.** Les notifications d’alertes externes, la collecte des journaux et l’IA ne sont pas branchées ici. Une mesure absente doit être interprétée comme inconnue."
      }
    },
    {
      "id": 2,
      "title": "Boutique et chemin WAF",
      "type": "stat",
      "description": "1 = sonde réussie ; 0 = indisponible ; absence = état inconnu. Pas de preuve métier.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "rearm-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "rearm-prometheus"
          },
          "expr": "probe_success{service=\"Boutique via WAF\"} * on(job,instance) up{job=~\"rearm_http|rearm_public\"}",
          "legendFormat": "{{service}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "Aucune mesure",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "INDISPONIBLE",
                  "color": "red"
                },
                "1": {
                  "text": "DISPONIBLE",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
